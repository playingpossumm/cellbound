{
  "name": "cellbound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Variant sudoku with daily puzzles, roguelite runs and fog.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:daily": "tsx scripts/gen-daily.ts",
    "gen:practice": "tsx scripts/craft-practice.ts",
    "calibrate:run": "tsx scripts/calibrate-run.ts",
    "e2e": "playwright test",
    "e2e:edge": "playwright test --project=phone --project=laptop --project=production"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "glob": "^13.0.6"
  }
}
